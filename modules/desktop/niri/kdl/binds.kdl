binds {
    Mod+0 { focus-workspace 0; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+A { spawn "fuzzel"; }
    Mod+B { spawn "zen-twilight" "--new-window"; }
    Mod+C { center-column; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+E { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { maximize-column; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+MouseBack { focus-column-left; }
    Mod+MouseForward { focus-column-right; }
    Mod+N { spawn "sh" "-c" "nmcli -t -f name,type connection show | grep vpn | cut -d: -f1 | fuzzel --dmenu | xargs -r nmcli connection up"; }
    Mod+O { toggle-overview; }
    Mod+P { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --copy-command=\"wl-copy\" --early-exit -f -"; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+Q { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+S { spawn "keepmenu"; }
    Mod+Shift+0 { move-column-to-workspace 0; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+B { spawn "fuzzel-bluetooth"; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+P { spawn "sh" "-c" "grim - | satty --copy-command=\"wl-copy\" --early-exit -f -"; }
    Mod+Shift+R { reset-window-height; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+S { spawn "keepmenu" "-t"; }
    Mod+Shift+Slash { move-column-to-workspace "scratch"; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+W { switch-focus-between-floating-and-tiling; }
    Mod+Slash { focus-workspace "scratch"; }
    Mod+T { spawn "kitty"; }
    Mod+TouchpadScrollDown { focus-column-right; }
    Mod+TouchpadScrollUp { focus-column-left; }
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }
    Mod+W { toggle-window-floating; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
}
